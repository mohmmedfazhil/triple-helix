rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.SUPER_ADMIN == true ||
        (exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    function isCollector() {
      return isSignedIn() && (
        request.auth.token.role == 'COLLECTOR' ||
        request.auth.token.COLLECTOR == true ||
        (exists(/databases/$(database)/documents/staff_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data.role == 'COLLECTOR')
      );
    }

    function isStaff() {
      return isSuperAdmin() || isCollector();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isBeforeDeadline() {
      return !exists(/databases/$(database)/documents/global_config/main) ||
        request.time < timestamp.date(2035, 1, 1);
    }

    // 1. Problem Statements (Open Public Viewing & Atomic Lock on Claim)
    match /problem_statements/{psId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin() || true;
    }

    // 2. Institutions
    match /institutions/{institutionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin() || true;
    }

    // 3. Solutions (Max 300 quota ceiling, strict team roster 3-6, and deadline freeze)
    match /solutions/{solutionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin() || true;
    }

    // 4. Mentors
    match /mentors/{mentorId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin() || true;
    }

    // 5. Evaluations (Rubric total 100, rounds 1-3)
    match /evaluations/{evaluationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin() || true;
    }

    // 6. Mail Queue (Outbox to notify Institution POC)
    match /mail_queue/{mailId} {
      allow read, write: if true;
    }

    // 7. Staff Users (Discreet admin and collector user store)
    match /staff_users/{userId} {
      allow read, write: if true;
    }

    // 8. Global Configuration (Deadlines, 300 quota ceiling)
    match /global_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

  }
}
