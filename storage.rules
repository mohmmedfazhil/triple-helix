rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /solutions/{institutionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || fileName.matches('.*\\.pdf$'));
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
